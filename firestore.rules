rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/folders/{folderId} {
      allow read, delete: if ownsUserData(userId);
      allow create: if ownsUserData(userId)
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if false;

      match /requests/{requestId} {
        allow read, delete: if ownsUserData(userId);
        allow create: if ownsUserData(userId)
          && request.resource.data.keys().hasOnly([
            'name',
            'method',
            'useSplitInput',
            'baseUrl',
            'model',
            'finalPath',
            'url',
            'params',
            'headers',
            'body',
            'bodyType',
            'tokenType',
            'tokenKey',
            'customTokenKey',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'name',
            'method',
            'useSplitInput',
            'baseUrl',
            'model',
            'finalPath',
            'url',
            'params',
            'headers',
            'body',
            'bodyType',
            'tokenType',
            'tokenKey',
            'customTokenKey',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.method in ['GET', 'POST', 'PUT', 'DELETE', 'PATCH']
          && request.resource.data.useSplitInput is bool
          && request.resource.data.baseUrl is string
          && request.resource.data.baseUrl.size() <= 2048
          && request.resource.data.model is string
          && request.resource.data.model.size() <= 2048
          && request.resource.data.finalPath is string
          && request.resource.data.finalPath.size() <= 2048
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 4096
          && request.resource.data.params is list
          && request.resource.data.params.size() <= 100
          && request.resource.data.headers is string
          && request.resource.data.headers.size() <= 16000
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 300000
          && request.resource.data.bodyType in ['json', 'text', 'html', 'xml', 'form']
          && request.resource.data.tokenType in ['Bearer', 'Basic', 'Custom']
          && request.resource.data.tokenKey is string
          && request.resource.data.customTokenKey is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if false;
      }
    }
  }
}
